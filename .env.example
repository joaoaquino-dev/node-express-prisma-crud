# Exemplo de variáveis de ambiente. Copie para .env e preencha com seus valores.
# Nunca versione o arquivo .env.

# String de conexão do MongoDB (por exemplo, um cluster gratuito do MongoDB Atlas).
DATABASE_URL="mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/NOME_DO_BANCO"

# Porta do servidor (opcional; o padrão é 3000).
PORT=3000
